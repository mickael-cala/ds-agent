# Variables d'environnement — copiez ce fichier en `.env` (ignoré par git)
# puis `set -a; . ./.env; set +a`

# Obligatoire : clé API DeepSeek
DEEPSEEK_API_KEY=

# Optionnel : modèle (défaut : deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Optionnel : base de l'API (proxy, mock, serveur de test)
# DEEPSEEK_API_BASE=https://api.deepseek.com

# Optionnel : fenêtre de contexte en tokens (défaut : 60000)
# DEEPSEEK_CONTEXT_TOKENS=60000

# Optionnel : secret de re-racinage du serveur MCP (outil change_root)
# MCP_ROOT_SECRET=changeme
